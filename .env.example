# ==== Приложение ====
DEBUG=false

# ==== База данных (PostgreSQL) ====
DATABASE_URL=postgresql+asyncpg://terradata:terradata@localhost:5432/terradata

# ==== JWT ====
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ==== Администратор (создаётся при старте, если ADMIN_PASSWORD задан) ====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# ==== Квоты запросов ====
DEFAULT_DAILY_QUOTA=1000
